library Differential version '1.0'
using FHIR version '4.0.1'
include FHIRHelpers version '4.0.1'
// Written by hand, then a grid: the cases of docs/plans/017-age-duration.md.
// An age is a duration (CQL 1.5.3, Appendix B, CalculateAgeAt: "defined in terms
// of a datetime duration calculation"), so CalculateAgeIn<Unit>At(birth, asOf) is
// `<unit>s between birth and asOf`: in the seven units, years to seconds, for a
// Date and a DateTime, with an uncertainty where a date is too imprecise for the
// unit; and CalculateAgeIn<Unit> against Today() or Now(). The hand cases are
// the specification's example, the plan's table, negative ages, the leap day and
// declared offsets; the grid, from D42, is two births (a leap day and the last
// millisecond of a year) at every precision against a reference at every
// precision. No Patient context (the AgeIn<Unit> operators are in
// testdata/ages and the tests), and no Date beside a DateTime in a `between`.
define D0: CalculateAgeInYearsAt(@2000-01-01, @2015-01-01)
define D1: CalculateAgeInYearsAt(@2000-01-01, null)
define D2: CalculateAgeInYearsAt(null, @2015-01-01)
define D3: CalculateAgeInYearsAt(@1965, @2019-01-01)
define D4: CalculateAgeInMonthsAt(@1965, @2019-01-01)
